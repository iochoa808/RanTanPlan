;; visit_all_bool, 4x4 grid (16 places) — classic boolean-predicate goal.
;; Classical counterpart of visit_all_sets/instances/n4.pddl (same grid, same plans).
;; Robot starts at x0y0, which counts as already visited.
;; Adjacency is the static (connects ?x ?y) predicate — no set features.
;; Goal: 16 (visited ?wp) atoms — one per place, so the goal grows with the grid.

(define (problem visit_all_bool_4x4)
    (:domain visit-all-bool)
    (:objects
        x0y0 x0y1 x0y2 x0y3 x1y0
        x1y1 x1y2 x1y3 x2y0 x2y1
        x2y2 x2y3 x3y0 x3y1 x3y2
        x3y3 - place
    )
    (:init
        (= (robot_at) x0y0)
        (visited x0y0)
        (connects x0y0 x0y1)
        (connects x0y0 x1y0)
        (connects x0y1 x0y2)
        (connects x0y1 x0y0)
        (connects x0y1 x1y1)
        (connects x0y2 x0y3)
        (connects x0y2 x0y1)
        (connects x0y2 x1y2)
        (connects x0y3 x0y2)
        (connects x0y3 x1y3)
        (connects x1y0 x1y1)
        (connects x1y0 x2y0)
        (connects x1y0 x0y0)
        (connects x1y1 x1y2)
        (connects x1y1 x1y0)
        (connects x1y1 x2y1)
        (connects x1y1 x0y1)
        (connects x1y2 x1y3)
        (connects x1y2 x1y1)
        (connects x1y2 x2y2)
        (connects x1y2 x0y2)
        (connects x1y3 x1y2)
        (connects x1y3 x2y3)
        (connects x1y3 x0y3)
        (connects x2y0 x2y1)
        (connects x2y0 x3y0)
        (connects x2y0 x1y0)
        (connects x2y1 x2y2)
        (connects x2y1 x2y0)
        (connects x2y1 x3y1)
        (connects x2y1 x1y1)
        (connects x2y2 x2y3)
        (connects x2y2 x2y1)
        (connects x2y2 x3y2)
        (connects x2y2 x1y2)
        (connects x2y3 x2y2)
        (connects x2y3 x3y3)
        (connects x2y3 x1y3)
        (connects x3y0 x3y1)
        (connects x3y0 x2y0)
        (connects x3y1 x3y2)
        (connects x3y1 x3y0)
        (connects x3y1 x2y1)
        (connects x3y2 x3y3)
        (connects x3y2 x3y1)
        (connects x3y2 x2y2)
        (connects x3y3 x3y2)
        (connects x3y3 x2y3)
    )
    (:goal
        (and
            (visited x0y0)
            (visited x0y1)
            (visited x0y2)
            (visited x0y3)
            (visited x1y0)
            (visited x1y1)
            (visited x1y2)
            (visited x1y3)
            (visited x2y0)
            (visited x2y1)
            (visited x2y2)
            (visited x2y3)
            (visited x3y0)
            (visited x3y1)
            (visited x3y2)
            (visited x3y3)
        )
    )
)
